{
  "name": "webapp-compras",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Registro pessoal de compras: local-first no aparelho, sincronizado com Postgres na nuvem.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx servidor/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch servidor/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.servidor.json",
    "build": "npm run typecheck && vite build && npm run build:servidor",
    "build:servidor": "esbuild servidor/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-servidor/index.js",
    "start": "node dist-servidor/index.js",
    "banco:criar": "tsx scripts/criar-banco.ts",
    "senha:hash": "tsx scripts/gerar-hash.ts",
    "icones": "tsx scripts/gerar-icones.ts",
    "teste:sync": "tsx scripts/testar-sincronizacao.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@hono/node-server": "^2.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
