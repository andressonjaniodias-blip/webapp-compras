# Copie para .env e preencha. O .env NAO vai para o git.

# Postgres do Neon. Sem isto, o servidor sobe com um Postgres local em .dados/
# (PGlite) — bom para desenvolver e testar sem criar conta em lugar nenhum.
DATABASE_URL=

# Hash da senha de acesso. Gere com: npm run senha:hash
SENHA_HASH=

# Segredo que assina o cookie de sessao. Qualquer string longa e aleatoria.
SESSAO_SEGREDO=

# Chave da API da Anthropic. Sem ela o app funciona; so as dicas ficam desligadas.
ANTHROPIC_API_KEY=

PORT=8787
